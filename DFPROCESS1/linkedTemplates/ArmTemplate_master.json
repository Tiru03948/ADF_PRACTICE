{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "DFPROCESS1"
		},
		"adlsconnect_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'adlsconnect'"
		},
		"dbconnect_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'dbconnect'"
		},
		"AzureKeyVault_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://kvindiaanalytics.vault.azure.net/"
		},
		"adlsconnect_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://saindiaana.dfs.core.windows.net/"
		},
		"dbconnect_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "indiadata.database.windows.net"
		},
		"dbconnect_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "dbindiaanalytics"
		},
		"dbconnect_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "dbmanager1"
		},
		"tumbling-window_properties_pipeline_parameters_Schema": {
			"type": "string",
			"defaultValue": "dbo"
		},
		"tumbling-window_properties_pipeline_parameters_Tablename": {
			"type": "string",
			"defaultValue": "Employees"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "DFPROCESS1_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"adlsconnect_accountKey": {
						"value": "[parameters('adlsconnect_accountKey')]"
					},
					"dbconnect_password": {
						"value": "[parameters('dbconnect_password')]"
					},
					"AzureKeyVault_properties_typeProperties_baseUrl": {
						"value": "[parameters('AzureKeyVault_properties_typeProperties_baseUrl')]"
					},
					"adlsconnect_properties_typeProperties_url": {
						"value": "[parameters('adlsconnect_properties_typeProperties_url')]"
					},
					"dbconnect_properties_typeProperties_server": {
						"value": "[parameters('dbconnect_properties_typeProperties_server')]"
					},
					"dbconnect_properties_typeProperties_database": {
						"value": "[parameters('dbconnect_properties_typeProperties_database')]"
					},
					"dbconnect_properties_typeProperties_userName": {
						"value": "[parameters('dbconnect_properties_typeProperties_userName')]"
					},
					"tumbling-window_properties_pipeline_parameters_Schema": {
						"value": "[parameters('tumbling-window_properties_pipeline_parameters_Schema')]"
					},
					"tumbling-window_properties_pipeline_parameters_Tablename": {
						"value": "[parameters('tumbling-window_properties_pipeline_parameters_Tablename')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}