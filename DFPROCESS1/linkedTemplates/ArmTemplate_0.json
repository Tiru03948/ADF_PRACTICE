{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "DFPROCESS1"
		},
		"adlsconnect_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'adlsconnect'"
		},
		"dbconnect_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'dbconnect'"
		},
		"AzureKeyVault_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://kvindiaanalytics.vault.azure.net/"
		},
		"adlsconnect_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://saindiaana.dfs.core.windows.net/"
		},
		"dbconnect_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "indiadata.database.windows.net"
		},
		"dbconnect_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "dbindiaanalytics"
		},
		"dbconnect_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "dbmanager1"
		},
		"tumbling-window_properties_pipeline_parameters_Schema": {
			"type": "string",
			"defaultValue": "dbo"
		},
		"tumbling-window_properties_pipeline_parameters_Tablename": {
			"type": "string",
			"defaultValue": "Employees"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/varible_addition')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"description": "this pipeline created by given exercise",
				"activities": [
					{
						"name": "Set variableX",
						"type": "SetVariable",
						"dependsOn": [],
						"policy": {
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"variableName": "varibleX",
							"value": 10
						}
					},
					{
						"name": "Set variableY",
						"type": "SetVariable",
						"dependsOn": [
							{
								"activity": "Set variableX",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"variableName": "varibleY",
							"value": {
								"value": "@add(variables('varibleX'),1)",
								"type": "Expression"
							}
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"variables": {
					"varibleX": {
						"type": "Integer"
					},
					"varibleTemp": {
						"type": "Integer"
					},
					"varibleY": {
						"type": "Integer"
					}
				},
				"annotations": [],
				"lastPublishTime": "2026-05-11T11:26:16Z"
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/AzureKeyVault')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
