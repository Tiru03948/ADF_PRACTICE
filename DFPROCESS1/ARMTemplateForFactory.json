{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "DFPROCESS1"
		},
		"adlsconnect_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'adlsconnect'"
		},
		"dbconnect_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'dbconnect'"
		},
		"AzureKeyVault_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://kvindiaanalytics.vault.azure.net/"
		},
		"adlsconnect_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://saindiaana.dfs.core.windows.net/"
		},
		"dbconnect_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "indiadata.database.windows.net"
		},
		"dbconnect_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "dbindiaanalytics"
		},
		"dbconnect_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "dbmanager1"
		},
		"tumbling-window_properties_pipeline_parameters_Schema": {
			"type": "string",
			"defaultValue": "dbo"
		},
		"tumbling-window_properties_pipeline_parameters_Tablename": {
			"type": "string",
			"defaultValue": "Employees"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/Full data load')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "Copy data",
						"type": "Copy",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "AzureSqlSource",
								"queryTimeout": "02:00:00",
								"partitionOption": "None"
							},
							"sink": {
								"type": "AzureSqlSink",
								"preCopyScript": "truncate table tgt.Transactions;",
								"writeBehavior": "insert",
								"sqlWriterUseTableLock": false,
								"disableMetricsCollection": false
							},
							"enableStaging": false,
							"translator": {
								"type": "TabularTranslator",
								"typeConversion": true,
								"typeConversionSettings": {
									"allowDataTruncation": true,
									"treatBooleanAsNumber": false
								}
							}
						},
						"inputs": [
							{
								"referenceName": "ADB",
								"type": "DatasetReference",
								"parameters": {
									"schema": "dbo",
									"tablename": "Transactions"
								}
							}
						],
						"outputs": [
							{
								"referenceName": "ADB",
								"type": "DatasetReference",
								"parameters": {
									"schema": "tgt",
									"tablename": "Transactions"
								}
							}
						]
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"annotations": []
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/ADB')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/Incremental_data_load_transactions')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "Copy data",
						"type": "Copy",
						"dependsOn": [
							{
								"activity": "get_last_modifieddate",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "AzureSqlSource",
								"sqlReaderQuery": {
									"value": "select * from dbo.Transactions \nwhere lastmodifieddate>cast('@{activity('get_last_modifieddate').output.resultSets[0].rows[0].max_date}' as datetime)",
									"type": "Expression"
								},
								"queryTimeout": "02:00:00",
								"partitionOption": "None"
							},
							"sink": {
								"type": "AzureSqlSink",
								"writeBehavior": "upsert",
								"upsertSettings": {
									"useTempDB": false,
									"keys": [
										"TxnId"
									]
								},
								"sqlWriterUseTableLock": false,
								"disableMetricsCollection": false
							},
							"enableStaging": false,
							"translator": {
								"type": "TabularTranslator",
								"typeConversion": true,
								"typeConversionSettings": {
									"allowDataTruncation": true,
									"treatBooleanAsNumber": false
								}
							}
						},
						"inputs": [
							{
								"referenceName": "ADB",
								"type": "DatasetReference",
								"parameters": {
									"schema": "dbo",
									"tablename": "Transactions"
								}
							}
						],
						"outputs": [
							{
								"referenceName": "ADB",
								"type": "DatasetReference",
								"parameters": {
									"schema": "tgt",
									"tablename": "Transactions"
								}
							}
						]
					},
					{
						"name": "get_last_modifieddate",
						"description": "Activity used to identify the max last modified date time in target table",
						"type": "Script",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"linkedServiceName": {
							"referenceName": "dbconnect",
							"type": "LinkedServiceReference"
						},
						"typeProperties": {
							"scripts": [
								{
									"type": "Query",
									"text": {
										"value": "select max(lastmodifieddate) as max_date from tgt.Transactions;",
										"type": "Expression"
									}
								}
							],
							"scriptBlockExecutionTimeout": "02:00:00"
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"variables": {
					"var1": {
						"type": "String"
					}
				},
				"annotations": []
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/ADB')]",
				"[concat(variables('factoryId'), '/linkedServices/dbconnect')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/activity_logging_pipeline')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"description": "pipelines used to maintain logs of the Datafatory pipelines using a stored procedure activity",
