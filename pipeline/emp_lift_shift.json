						"parameters": {
							"schema": {
								"value": "@pipeline().parameters.Schema",
								"type": "Expression"
							},
							"tablename": {
								"value": "@pipeline().parameters.Tablename",
								"type": "Expression"
							}
						}
					}
				],
				"outputs": [
					{
						"referenceName": "ADLS",
						"type": "DatasetReference"
					}
				]
			}
		],
		"parameters": {
			"Schema": {
				"type": "string"
			},
			"Tablename": {
				"type": "string"
			}
		},
		"annotations": [],
		"lastPublishTime": "2026-05-11T07:06:41Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
